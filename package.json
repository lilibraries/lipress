{
  "name": "@lilib/lipress",
  "version": "0.1.0",
  "description": "",
  "keywords": [],
  "author": {
    "name": "李蔚生 (LeeWeisheng)",
    "url": "https://github.com/LeeWeisheng"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilibraries/lipress.git"
  },
  "bugs": {
    "url": "https://github.com/lilibraries/lipress/issues"
  },
  "homepage": "https://github.com/lilibraries/lipress",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "pnpm@12.14.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "lipress": "./bin/lipress.mjs"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "husky",
    "start": "npm run dev",
    "dev": "node scripts/watch-dev.mjs node bin/lipress.mjs dev",
    "lint": "tsc -p tsconfig.json && eslint . --max-warnings 0 && stylelint \"src/**/*.{css,scss}\" --max-warnings 0 && prettier --check . --log-level warn",
    "lint:fix": "tsc -p tsconfig.json && eslint . --fix --max-warnings 0 && stylelint \"src/**/*.{css,scss}\" --fix --max-warnings 0 && prettier --write . --log-level warn",
    "test": "jest",
    "dist": "rimraf dist && concurrently --kill-others-on-fail npm:dist:*",
    "dist:esm": "tsc -p tsconfig.build.json",
    "dist:client": "cpy \"src/client/**/*\" dist/client",
    "release": "npm run release:dry-run && HUSKY=0 release-it",
    "release:dry-run": "npm run lint && npm run test && npm run dist && HUSKY=0 release-it --dry-run --ci"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@lilib/hooks": "^2.4.0",
    "classnames": "^2.5.1",
    "eta": "^4.6.0",
    "sass": "^1.105.2",
    "vite": "^8.3.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "^30.5.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "release-it": "^21.1.1",
    "rimraf": "^6.1.3",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.8.2",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.2",
    "ts-jest": "^29.4.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
